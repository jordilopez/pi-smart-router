{
  "name": "pi-smart-router",
  "version": "1.0.0",
  "description": "Smart model router extension for Pi Agent - routes prompts to optimal backend models based on complexity",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "pi-package",
    "pi-agent",
    "extension",
    "model-router",
    "smart-routing"
  ],
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
